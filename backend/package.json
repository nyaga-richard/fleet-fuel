{
  "name": "fleet-fuel-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Fleet Fuel Management System — Express API (production, self-hosted)",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "migrate": "node src/db/migrate.js",
    "migrate:down": "node src/db/migrate.js --down",
    "seed": "node seeds/dev_seed.js",
    "db:reset": "bash ../scripts/reset-db.sh",
    "test": "node --test tests/"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "node-pg-migrate": "^7.9.1",
    "pdfkit": "^0.20.2",
    "pg": "^8.16.3",
    "xlsx": "^0.18.5"
  }
}
