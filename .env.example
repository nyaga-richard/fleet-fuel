# ============================================================
# Fleet Fuel Management System — Environment Configuration
# Copy to `.env` (never commit `.env`) and fill in real values.
#   cp .env.example .env
# Generate strong secrets:
#   openssl rand -hex 32
# ============================================================

# ── Core ─────────────────────────────────────────────────────
NODE_ENV=production
APP_VERSION=1.0.0
TZ=Africa/Nairobi

# ── PORTS: every HOST port below is configurable ─────────────
# If another service on this server already uses one of the ports, change
# ONLY that host port and re-run ./scripts/deploy.sh — its preflight check
# verifies the new port is free BEFORE anything is touched, so a conflict
# can never cause downtime.
#
#   POSTGRES_PORT   host port for PostgreSQL   (default 5432)
#   API_PORT        host port for the API      (default 4000)
#   WEB_PORT        host port for the web app  (default 3000)
#
# Container-internal ports (e.g. 5432 inside the Docker network in
# DATABASE_URL below) NEVER conflict with host services and do not need to
# change. Cloudflare Tunnel service URLs (http://web:3000,
# http://backend:4000) and the mobile app's public URL are unaffected by
# host port changes. *_BIND must stay 127.0.0.1 in production — public
# access is exclusively via the Cloudflare Tunnel.

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_DB=fleetfuel
POSTGRES_USER=fleetfuel
POSTGRES_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
POSTGRES_BIND=127.0.0.1
POSTGRES_PORT=5432
# Container-network URL used by the backend + migration tools (not a host port):
DATABASE_URL=postgresql://fleetfuel:CHANGE_THIS_STRONG_PASSWORD@postgres:5432/fleetfuel

# ── Backend API ──────────────────────────────────────────────
API_PORT=4000
# PRODUCTION MUST BE 127.0.0.1 — public route is the Cloudflare Tunnel.
API_BIND=127.0.0.1
# LONG random secret — openssl rand -hex 32
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=12h
# Comma-separated list of allowed browser origins (no trailing slash).
# The mobile app is a native client and is not affected by CORS.
CORS_ORIGIN=https://fuel.example.com
# Initial seed administrator (only used on an EMPTY database, and only
# when seeding is explicitly invoked — see README "Seed data").
SEED_ADMIN_EMAIL=admin@fleetfuel.local
SEED_ADMIN_NAME=Administrator
SEED_ADMIN_PASSWORD=CHANGE_THIS_ADMIN_PASSWORD

# ── Web frontend ─────────────────────────────────────────────
WEB_PORT=3000
# PRODUCTION MUST BE 127.0.0.1 — public route is the Cloudflare Tunnel.
WEB_BIND=127.0.0.1
# Baked into the web bundle at BUILD time (public URL of the API):
NEXT_PUBLIC_API_URL=https://api.fuel.example.com

# ── Domains (Cloudflare Tunnel) ──────────────────────────────
WEB_DOMAIN=fuel.example.com
API_DOMAIN=api.fuel.example.com

# ── Cloudflare Tunnel ────────────────────────────────────────
# Token from Cloudflare Zero Trust → Networks → Tunnels → fleet-fuel.
# The deployment script refuses to start cloudflared without it.
CLOUDFLARE_TUNNEL_TOKEN=CHANGE_THIS_TUNNEL_TOKEN

# ── Backups ──────────────────────────────────────────────────
# Production directory (created by scripts/install.sh). Backups also
# include a configurable retention policy (see scripts/backup.sh):
BACKUP_DIR=/opt/fleet-fuel/backups
BACKUP_RETENTION_DAILY=30       # keep daily backups for N days
BACKUP_RETENTION_WEEKLY=12      # keep one backup per ISO week for N weeks
BACKUP_RETENTION_MONTHLY=12     # keep one backup per month for N months

# ── Optional: seed demo data (DEVELOPMENT ONLY) ──────────────
# `npm run seed` in backend/ inserts an idempotent starter data set.
# Production deployments must NOT run seeds against existing data.
SEED_DEMO_DATA=false
