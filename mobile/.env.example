# ── Mobile API configuration ─────────────────────────────────────────────────
# Public API URL served through Cloudflare Tunnel.
# NEVER hard-code localhost / 127.0.0.1 / 192.168.x.x in production builds.
#
# Development (Expo Go on a device — use your machine's LAN IP):
EXPO_PUBLIC_API_URL=http://192.168.1.50:4000
#
# Production:
# EXPO_PUBLIC_API_URL=https://api.fuel.example.com

# EAS project id — enables Expo push token registration (§40).
# Find it with: npx eas init (writes it to app.json extra.eas.projectId) or
# set EXPO_PUBLIC_EAS_PROJECT_ID here.
EXPO_PUBLIC_EAS_PROJECT_ID=
# ── Push notifications (§40) ─────────────────────────────────────────────────
# Remote push needs the EAS project id INLINED AT BUILD TIME. Without it the
# app still registers the device (in-app notifications work) but cannot fetch
# a push token — the Push diagnostics screen shows this exact reason.
#
#   npx eas init        → writes the id into app.json extra.eas.projectId
# …or set it manually (uncomment and paste your project id from eas init):
# EXPO_PUBLIC_EAS_PROJECT_ID=00000000-0000-0000-0000-000000000000
#
# Self-built APKs (gradlew assembleRelease) read this file via babel-preset-expo.
# For FCM delivery in self-built APKs you also need google-services.json in
# android/app/ (or use "eas build", which configures credentials for you).
