{
  "expo": {
    "name": "Fleet Fuel",
    "slug": "fleet-fuel",
    "version": "1.0.0",
    "scheme": "fleetfuel",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "backgroundColor": "#0b1220",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fleetfuel.app"
    },
    "android": {
      "package": "com.fleetfuel.app",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B1220"
      },
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "apiUrlOverrides": "Set EXPO_PUBLIC_API_URL in mobile/.env (see .env.example)"
    },
    "icon": "./assets/icon.png"
  }
}